DATABASE_URL="postgresql://onspot@localhost:54329/onspot?schema=public"
REDIS_URL="redis://localhost:6379"   # leave empty to use the in-memory geo index
JWT_SECRET="change-me"
PORT=4100
OTP_DEV_ECHO=true                     # false in production (codes go only via SMS)
PAYMENT_GATEWAY=mock                  # mock | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PUBLIC_WEB_URL=https://onspot.app
PUSH_DRIVER=expo                      # expo | log (print only) | memory (tests)
EXPO_ACCESS_TOKEN=                    # only if Expo enhanced push security is enabled
