{
  "name": "onspot",
  "private": true,
  "version": "0.1.0",
  "description": "OnSpot: on-demand roadside and home emergency marketplace",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build:shared": "npm run build -w @onspot/shared",
    "db:start": "pg_ctl -D .pgdata -o \"-p 54329\" -l .pgdata/server.log start",
    "db:stop": "pg_ctl -D .pgdata stop",
    "api:dev": "npm run dev -w @onspot/api",
    "api:test": "npm run test:e2e -w @onspot/api"
  }
}
