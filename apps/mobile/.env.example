# Copy to .env (git-ignored). Read by the dev server on this PC when you run `npx expo start`.
# A phone can't reach "localhost" on your PC: use your PC's Wi-Fi/LAN IP (ipconfig → IPv4 Address),
# or http://10.0.2.2:4100/v1 for the Android emulator. Both phone and PC must be on the same network,
# and Windows Firewall must allow port 4100.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4100/v1

# Build-time only (set as EAS environment variables for cloud builds, see docs/ANDROID.md):
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_SERVICES_JSON=./google-services.json
